module LCD16X2 (Clock, SDA, SCL, Start, Address, CHAR1, CHAR2, CHAR3, CHAR4, CHAR5, CHAR6, CHAR7, CHAR8, CHAR9, CHAR10, CHAR11, CHAR12, CHAR13, CHAR14, CHAR15, CHAR16, CHAR17, CHAR18, CHAR19, CHAR20, CHAR21, CHAR22, CHAR23, CHAR24, CHAR25, CHAR26, CHAR27, CHAR28, CHAR29, CHAR30, CHAR31, CHAR32, End);

input Clock;
output SDA;
output SCL;
output wire End;


input wire Start;
input wire [6:0] Address;

input wire [7:0] CHAR1;
input wire [7:0] CHAR2;
input wire [7:0] CHAR3;
input wire [7:0] CHAR4;
input wire [7:0] CHAR5;
input wire [7:0] CHAR6;
input wire [7:0] CHAR7;
input wire [7:0] CHAR8;
input wire [7:0] CHAR9;
input wire [7:0] CHAR10;
input wire [7:0] CHAR11;
input wire [7:0] CHAR12;
input wire [7:0] CHAR13;
input wire [7:0] CHAR14;
input wire [7:0] CHAR15;
input wire [7:0] CHAR16;

input wire [7:0] CHAR17;
input wire [7:0] CHAR18;
input wire [7:0] CHAR19;
input wire [7:0] CHAR20;
input wire [7:0] CHAR21;
input wire [7:0] CHAR22;
input wire [7:0] CHAR23;
input wire [7:0] CHAR24;
input wire [7:0] CHAR25;
input wire [7:0] CHAR26;
input wire [7:0] CHAR27;
input wire [7:0] CHAR28;
input wire [7:0] CHAR29;
input wire [7:0] CHAR30;
input wire [7:0] CHAR31;
input wire [7:0] CHAR32;



reg [7:0] DataI;
reg [14:0]Delay;
wire [7:0] DataO;
wire SDAI;
wire S;
wire Request;
reg Inicio;
reg [9:0] Counter_data;
reg Reset;


//Inicializacion Display
reg [15:0] IData1=16'b0011110000111100;
reg [15:0] IData2=16'b0011110000101100;
reg [15:0] IData3=16'b0010110010001100;
reg [15:0] IData4=16'b0000110010001100;
reg [15:0] IData5=16'b0000110000011100;
reg [15:0] IData6=16'b0000110001111100;
reg [15:0] IData7=16'b0000110011001100;


initial begin
Counter_data=1'b0;
Delay=1'b0;
end

DivFKHz Clock25KHz (Clock, S);
I2CLCDRW I2C (Reset, Inicio, S, Address, DataI, DataO, 1'b0, SDA, SDAI, SCL, 9'd251, End, Request);


always @(posedge S)begin



if(Start==1'b1)begin

	if(End)begin
		Counter_data=1'b0;
		Delay<=15'd4;
	end

	if(Delay!=0)begin
		Delay<= Delay-1'b1;
		Reset<=1;
		Inicio<=0;
	end
	else begin
		Reset<=0;
		Inicio<=1;
	end


	if(Request)Counter_data=Counter_data+1'b1;

		if(Counter_data==0)DataI=IData1[15:8];
		else if(Counter_data==1)DataI={IData1[15:11],1'b0, IData1[9:8]};
		else if(Counter_data==2)DataI=IData1[7:0];
		else if(Counter_data==3)DataI={IData1[7:3],1'b0, IData1[1:0]};
		else if(Counter_data==4)DataI=IData2[15:8];
		else if(Counter_data==5)DataI={IData2[15:11],1'b0, IData2[9:8]};
		else if(Counter_data==6)DataI=IData2[7:0];
